#!/bin/sh
printf '\n[3ZK] Validando catalogo antes do commit...\n'
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1

if command -v powershell.exe >/dev/null 2>&1; then
  if command -v cygpath >/dev/null 2>&1; then
    SCRIPT="$(cygpath -w "$ROOT/automacao/validar_catalogo.ps1")"
  else
    SCRIPT="$ROOT/automacao/validar_catalogo.ps1"
  fi
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
  status=$?
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$ROOT/automacao/validar_catalogo.ps1"
  status=$?
elif command -v py >/dev/null 2>&1; then
  py -3 "$ROOT/automacao/validar_catalogo.py"
  status=$?
elif command -v python >/dev/null 2>&1; then
  python "$ROOT/automacao/validar_catalogo.py"
  status=$?
else
  printf '[3ZK] ERRO: PowerShell e Python nao foram encontrados.\n'
  exit 1
fi

if [ "$status" -ne 0 ]; then
  printf '\n[3ZK] Commit bloqueado. Corrija os erros acima.\n'
  exit "$status"
fi
printf '[3ZK] Validacao aprovada.\n\n'
